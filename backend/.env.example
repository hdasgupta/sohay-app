# ============================================================
# WBFFMH Appointment Booking - BACKEND ENVIRONMENT
# ============================================================
NODE_ENV=development
PORT=5000

# ---- Frontend (used to build in-app appointment / video links) ----
FRONTEND_URL=http://localhost:5173
# On production set: FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Backend public url (used inside emails / webhooks) ----
BACKEND_URL=http://localhost:5000

# ---- Database (Neon Postgres) ----
DATABASE_URL=
PGSSL=true

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES_IN=12h
CAPTCHA_SECRET=
CAPTCHA_TTL_SECONDS=300
BCRYPT_SALT_ROUNDS=12

# ---- Seed admin (created automatically on first backend run) ----
SEED_ADMIN_NAME=WBFFMH Administrator
SEED_ADMIN_EMAIL=wbffmh@gmail.com
SEED_ADMIN_PASSWORD=

# ---- OTP ----
OTP_TTL_MINUTES=10
OTP_LENGTH=6

# ---- Outgoing email (Gmail app password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=himaghna.dasgupta@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=West Bengal Forum for Mental Health
MAIL_FROM=himaghna.dasgupta@gmail.com

# ---- Neon S3 compatible object storage (prescription pdf) ----
AWS_ENDPOINT_URL_S3=https://br-sparkling-sound-a158ghix.storage.c-1.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=prescriptions
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
PRESCRIPTION_URL_TTL_SECONDS=604800

# ---- Organisation branding used on prescription pdf ----
ORG_NAME=West Bengal Forum for Mental Health
ORG_LOGO_PATH=assets/logo.png
DOCTOR_SIGNATURE_PATH=assets/signature.png

# ---- Jitsi 8x8.vc (JaaS) video consultation ----
JITSI_DOMAIN=8x8.vc
# Used when the JaaS credentials below are empty (8x8.vc refuses tokenless joins)
JITSI_FALLBACK_DOMAIN=meet.jit.si
JAAS_APP_ID=
JAAS_API_KEY=
# Paste the JaaS private key (single line, \n escaped) OR set JAAS_PRIVATE_KEY_PATH
JAAS_PRIVATE_KEY=
JAAS_PRIVATE_KEY_PATH=assets/jaas.pem
JAAS_TOKEN_TTL_SECONDS=7200
# Shared secret that JaaS webhook calls must present (x-webhook-secret header)
JAAS_WEBHOOK_SECRET=

# ---- Google Drive upload of doctor side recording ----
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_OWNER_EMAIL=himaghna.dasgupta@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ---- Medicine master data bootstrap ----
MEDICINE_CSV_URL=https://raw.githubusercontent.com/junioralive/Indian-Medicine-Dataset/refs/heads/main/DATA/indian_medicine_data.csv
MEDICINE_IMPORT_LIMIT=40000

# ---- Scheduled jobs ----
CANCEL_JOB_CRON=0 0 * * *
CANCEL_JOB_TIMEZONE=Asia/Kolkata
