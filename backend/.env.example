# ================= PRODUCTION (Render + Neon + Vercel) =================
NODE_ENV=production
PORT=10000
APP_TIMEZONE=Asia/Kolkata

# Frontend (Vercel) URL - used in appointment / invitation emails and CORS
FRONTEND_URL=https://wbfmh-appointment.vercel.app
# Extra allowed origins (comma separated). Use * to reflect any origin.
CORS_ORIGINS=https://wbfmh-appointment.vercel.app
# Allow any *.vercel.app preview deployment
CORS_ALLOW_VERCEL_PREVIEWS=true

# Neon PostgreSQL
DATABASE_URL=
DB_SSL=true
DB_POOL_MAX=10

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
OTP_SECRET=
CAPTCHA_SECRET=
OTP_VALIDITY_MINUTES=10
CAPTCHA_VALIDITY_MINUTES=5

# Seed admin (created automatically on first run)
ADMIN_NAME=Administrator
ADMIN_EMAIL=wbffmh@gmail.com
ADMIN_PASSWORD=

# Resend (outgoing email)
RESEND_API_KEY=
# NOTE: onboarding@resend.dev can only deliver to the Resend account owner.
# Verify your own domain in Resend and change this sender for real patients.
EMAIL_FROM=West Bengal Forum for Mental Health <onboarding@resend.dev>
# resend | console (print emails to the server log, for offline development) | memory (tests)
EMAIL_PROVIDER=resend

# Neon object storage (S3 compatible) - prescription PDFs
STORAGE_PROVIDER=s3
AWS_ENDPOINT_URL_S3=https://br-sparkling-sound-a158ghix.storage.c-1.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
PRESCRIPTION_BUCKET=prescriptions

# Cloudflare R2 - meeting recordings (fill with your R2 details)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wbfmh-recordings
R2_PUBLIC_BASE_URL=

# 8x8 JaaS (Jitsi as a Service)
JAAS_APP_ID=vpaas-magic-cookie-f05a06c6b6a4427a8427ac58fdafb9bd
JAAS_API_KEY_ID=vpaas-magic-cookie-f05a06c6b6a4427a8427ac58fdafb9bd/d541c4
JAAS_DOMAIN=8x8.vc
# Webhook signing secret from JaaS console (Webhooks > Reveal secret)
JAAS_WEBHOOK_SECRET=
# Private key: newlines encoded as \n
JAAS_PRIVATE_KEY=

# Medicines dataset (loaded once when the medicines table is empty)
MEDICINE_CSV_URL=https://raw.githubusercontent.com/junioralive/Indian-Medicine-Dataset/refs/heads/main/DATA/indian_medicine_data.csv
MEDICINE_IMPORT_ON_START=true

# Jobs
ENABLE_CRON=true
