{
  "name": "wbfmh-appointment-backend",
  "version": "1.0.0",
  "description": "West Bengal Forum for Mental Health - Appointment booking API",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=.env.development server.js",
    "db:reset": "node src/db/cli.js reset",
    "db:init": "node src/db/cli.js init",
    "test": "NODE_ENV=test node --test --test-concurrency=1 --test-timeout=120000 \"tests/api/*.test.js\"",
    "test:perf": "NODE_ENV=test node --test --test-timeout=300000 tests/performance/load.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/lib-storage": "^3.1137.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "wrangler": "^4.136.3"
  }
}
